# Copy this file to .env and replace the placeholder with your free NASA FIRMS key.
FIRMS_MAP_KEY=your-personal-map-key

# Supabase browser access. The publishable key is safe to expose only with RLS.
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side bulk importer only. Never expose this value through a VITE_ variable.
SUPABASE_DB_URL=postgresql://postgres.your-project:password@host:6543/postgres
